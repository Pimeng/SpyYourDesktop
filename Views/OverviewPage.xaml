<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Desktop.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1040" Padding="32,28,32,40" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="概览" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="我会一直一直视奸你"
                           FontSize="15"
                           Opacity="0.7" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="上报窗口标题" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{ThemeResource BrandBrush}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="开始监控" Command="{Binding StartCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="停止监控" Command="{Binding StopCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="最近一次上报" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="只有成功发送的数据会显示在这里。" Opacity="0.68" />
                    </StackPanel>
                    <Grid RowSpacing="12" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="时间" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastSentAt}" />
                        <TextBlock Grid.Row="1" Text="应用" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastApplication}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="窗口标题" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastTitle}" TextWrapping="Wrap" MaxLines="3" />
                    </Grid>
                    <Button Content="打开日志" Command="{Binding OpenLogCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
