<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Desktop.Views.StrategyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1040" Padding="32,28,32,40" RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="采集策略" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="调整采样节奏、隐私方式和标题处理规则。"
                           FontSize="15"
                           Opacity="0.7" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="高级设置" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Header="监控间隔（秒）"
                                   Value="{Binding IntervalSeconds, Mode=TwoWay}"
                                   Minimum="5"
                                   Maximum="3600"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanEditSettings}" />
                        <NumberBox Header="强制心跳（秒）"
                                   Grid.Column="1"
                                   Value="{Binding HeartbeatSeconds, Mode=TwoWay}"
                                   Minimum="10"
                                   Maximum="3600"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanEditSettings}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="14">
                    <TextBlock Text="运行方式" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch Header="开机自启动"
                                  IsOn="{Binding AutoStart, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                    <ToggleSwitch Header="允许后台运行"
                                  IsOn="{Binding AllowBackground, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                    <ToggleSwitch Header="隐私模式"
                                  OnContent="不采集标题/应用"
                                  OffContent="采集标题/应用"
                                  IsOn="{Binding PrivacyMode, Mode=TwoWay}" />
                    <ToggleSwitch Header="允许长标题"
                                  OnContent="不截断"
                                  OffContent="截断至 140 字符"
                                  IsOn="{Binding ForceAllowLongTitle, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
