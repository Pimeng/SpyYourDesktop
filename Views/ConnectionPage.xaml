<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Desktop.Views.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer x:Name="ContentScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <Grid Width="{Binding ActualWidth, ElementName=ContentScrollViewer}"
                  MaxWidth="1040"
                  HorizontalAlignment="Center"
                  Padding="32,28,32,128">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="26">
                    <StackPanel Spacing="18">
                        <TextBlock Text="连接配置" Style="{StaticResource SectionTitleStyle}" />
                        <Grid RowSpacing="16" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="服务器地址" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://example.com/api/ingest"
                                     IsEnabled="{Binding CanEditSettings}" />
                            <TextBlock Grid.Row="1" Text="设备 ID" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding MachineId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="例如：anyi-desktop"
                                     IsEnabled="{Binding CanEditSettings}" />
                            <TextBlock Grid.Row="2" Text="上传密钥" Style="{StaticResource FieldLabelStyle}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="UploadKeyBox"
                                             PasswordChanged="UploadKeyBox_PasswordChanged"
                                             IsEnabled="{Binding CanEditSettings}"
                                             PlaceholderText="个人密钥或令牌" />
                                <CheckBox x:Name="ShowKeyCheckBox"
                                          Grid.Column="1"
                                          Content="显示"
                                          IsChecked="{Binding ShowKey, Mode=TwoWay}"
                                          Checked="ShowKeyCheckBox_Checked"
                                          Unchecked="ShowKeyCheckBox_Unchecked"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding CanEditSettings}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="18">
                    <TextBlock Text="高级配置" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Header="采集间隔（ms）"
                                   Value="{Binding IntervalMs, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="3600000"
                                   HorizontalAlignment="Stretch" />
                        <NumberBox Header="心跳（ms）"
                                   Grid.Column="1"
                                   Value="{Binding HeartbeatMs, Mode=TwoWay}"
                                   Minimum="0"
                                   Maximum="3600000"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                    <Grid RowSpacing="14" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Row="0"
                                  Header="开机自启动"
                                  SelectedIndex="{Binding StartupModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="禁用自启动" />
                            <ComboBoxItem Content="开机静默自启动并启动监控" />
                            <ComboBoxItem Content="开机显示窗口并启动监控" />
                        </ComboBox>
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  Header="关闭窗口行为"
                                  SelectedIndex="{Binding WindowCloseModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="最小化" />
                            <ComboBoxItem Content="退出" />
                        </ComboBox>
                        <ComboBox Grid.Row="1"
                                  Header="隐私模式"
                                  SelectedIndex="{Binding PrivacyModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="关（正常上报）" />
                            <ComboBoxItem Content="开（不上报任何内容）" />
                        </ComboBox>
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Header="是否上报过长标题"
                                  SelectedIndex="{Binding LongTitleModeIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="截断至 140 字符" />
                            <ComboBoxItem Content="不截断" />
                        </ComboBox>
                    </Grid>
                    <ToggleSwitch Header="读取并上报媒体信息（SMTC）"
                                  OnContent="上报媒体"
                                  OffContent="不上报媒体"
                                  IsOn="{Binding ReportMedia, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    <TextBlock Text="开启后，监控运行中也会生效：检测到曲目或播放状态变化时会额外上报媒体标题、艺术家、专辑、播放状态和来源应用；没有媒体在播放时不附加媒体信息。隐私模式开启时始终不读取。默认关闭。"
                               Opacity="0.68"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

             </Grid>
        </ScrollViewer>

        <Border Canvas.ZIndex="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="开始监控"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="停止监控"
                        Command="{Binding StopCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
