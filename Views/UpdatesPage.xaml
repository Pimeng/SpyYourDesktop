<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Desktop.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer x:Name="ContentScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto">
        <Grid Width="{Binding ActualWidth, ElementName=ContentScrollViewer}"
              MaxWidth="1040"
              HorizontalAlignment="Center"
              Padding="32,28,32,40"
              RowSpacing="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="更新与日志" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="检查新版本，或打开当前运行日志。"
                           FontSize="15"
                           Opacity="0.7" />
            </StackPanel>

            <Grid Grid.Row="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="26">
                    <StackPanel Spacing="14">
                        <TextBlock Text="应用更新" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Opacity="0.72" />
                        <StackPanel Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="10">
                            <TextBlock Text="{Binding UpdateTag}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdateNotes}" MaxLines="7" TextWrapping="Wrap" Opacity="0.72" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding UpdateActionText}" Command="{Binding ApplyUpdateCommand}" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="稍后" Command="{Binding SkipUpdateCommand}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="26">
                    <StackPanel Spacing="14">
                        <TextBlock Text="日志" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="日志记录采集、上报、限流和更新过程，便于排查连接问题。"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                        <TextBlock Text="{Binding CurrentLogFileName}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开日志文件"
                                    Command="{Binding OpenLogCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="打开日志目录"
                                    Command="{Binding OpenLogDirectoryCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
