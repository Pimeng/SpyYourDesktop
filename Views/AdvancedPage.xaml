<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Desktop.Views.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1040" Padding="22,28,32,40" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,12"
                    Padding="26">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="频率" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Header="采集间隔（秒）"
                                   Value="{Binding IntervalSeconds, Mode=TwoWay}"
                                   Minimum="3"
                                   Maximum="3600"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanEditSettings}" />
                        <NumberBox Header="心跳（秒）"
                                   Grid.Column="1"
                                   Value="{Binding HeartbeatSeconds, Mode=TwoWay}"
                                   Minimum="10"
                                   Maximum="3600"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="{Binding CanEditSettings}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">
                <StackPanel Spacing="14">
                    <TextBlock Text="运行方式" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch Header="开机自启动"
                                  OnContent="自启动"
                                  OffContent="禁用自启动"
                                  IsOn="{Binding AutoStart, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                    <ToggleSwitch Header="关闭窗口行为"
                                  OnContent="最小化"
                                  OffContent="退出"
                                  IsOn="{Binding AllowBackground, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                    <ToggleSwitch Header="隐私模式"
                                  OnContent="开（不上报任何内容）"
                                  OffContent="关（正常上报）"
                                  IsOn="{Binding PrivacyMode, Mode=TwoWay}" />
                    <ToggleSwitch Header="是否上报过长标题"
                                  OnContent="不截断"
                                  OffContent="截断至 140 字符"
                                  IsOn="{Binding ForceAllowLongTitle, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
